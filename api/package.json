  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "dotenv-cli": "^8.0.0",
    "jest": "^30.0.3",
    "supertest": "^7.1.1"
  },
  "jest": {
    "collectCoverage": true,
    "coverageDirectory": "coverage",
